# Copia este archivo a .env.local y llena los valores. Nunca subas .env.local a Git.

# Supabase (Oswaldo)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Secreto compartido para los webhooks que llaman n8n y ElevenLabs (header x-kyp-secret)
