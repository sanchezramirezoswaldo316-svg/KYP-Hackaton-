# Copia este archivo a .env.local y llena los valores. Nunca subas .env.local a Git.
# Sin ninguna variable, la app funciona en "modo demo": datos en memoria y llamadas simuladas.

# Contraseña opcional para todo el sitio (autenticación básica; el usuario que escribas queda en la bitácora)
APP_PASSWORD=

# Supabase: si se configuran, los datos se guardan en PostgreSQL (ejecuta supabase/migrations/0001_inicial.sql)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Firecrawl: lectura de la página web del proveedor y búsqueda de noticias
FIRECRAWL_API_KEY=

# Claude: compara el giro, evalúa noticias y redacta resúmenes (nunca decide el puntaje)
ANTHROPIC_API_KEY=

# ElevenLabs + Twilio: llamada de verificación de cambios de CLABE (ver voz/README.md)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=
EMPRESA_NOMBRE=
# Lista de teléfonos del equipo autorizados, E.164 separados por coma. Vacío impide llamadas.
VOZ_TELEFONOS_AUTORIZADOS=

# Secreto que n8n u otros sistemas envían en el header x-kyp-secret a /api/webhooks/*
# (la app también lo manda a n8n en los avisos)
WEBHOOK_SECRET=

# Avisos a proveedores (portal, recordatorios) y resumen diario: webhook de un flujo de n8n (ver n8n/README.md)
N8N_WEBHOOK_NOTIFICACIONES=

# URL pública de la app para armar el enlace del portal en los avisos (en Vercel se detecta sola)
APP_URL=

# Vercel Cron: secreto para la tarea diaria (monitoreo, recordatorios y resumen)
CRON_SECRET=
