# n8n (Alan)
N8N_WEBHOOK_ALTA_URL=
N8N_WEBHOOK_CLABE_URL=

# Firecrawl (Alan, se usa desde n8n)
FIRECRAWL_API_KEY=

# ElevenLabs + Twilio (Axel)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=

# Modelo de IA para resúmenes (Alan)
ANTHROPIC_API_KEY=
